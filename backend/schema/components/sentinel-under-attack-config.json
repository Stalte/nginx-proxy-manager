{
	"type": "object",
	"description": "Under attack settings of a proxy host",
	"additionalProperties": false,
	"properties": {
		"mode": {
			"type": "string",
			"enum": [
				"js",
				"cookie"
			],
			"example": "js"
		},
		"difficulty": {
			"type": "integer",
			"minimum": 12,
			"maximum": 24,
			"example": 16
		},
		"ttl": {
			"type": "integer",
			"minimum": 300,
			"maximum": 604800,
			"example": 86400
		},
		"bind": {
			"type": "string",
			"enum": [
				"ip",
				"ip_ua"
			],
			"example": "ip"
		},
		"rps": {
			"type": "number",
			"minimum": 1,
			"maximum": 1000000,
			"example": 200
		},
		"blocked_pct": {
			"type": "number",
			"minimum": 0,
			"maximum": 100,
			"example": 50
		},
		"window_s": {
			"type": "integer",
			"minimum": 10,
			"maximum": 600,
			"example": 30
		},
		"duration_s": {
			"type": "integer",
			"minimum": 60,
			"maximum": 86400,
			"example": 900
		},
		"pages": {
			"type": "boolean",
			"description": "Only challenge page loads (browser navigations), not API, websocket or app requests",
			"example": false
		}
	}
}
