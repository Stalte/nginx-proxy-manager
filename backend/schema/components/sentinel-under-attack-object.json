{
	"type": "object",
	"description": "Under attack mode of a proxy host",
	"additionalProperties": false,
	"required": [
		"proxy_host_id",
		"domain_names",
		"enabled",
		"under_attack",
		"config",
		"active",
		"since",
		"until",
		"reason",
		"no_autoban",
		"rate_limit"
	],
	"properties": {
		"proxy_host_id": {
			"$ref": "../common.json#/properties/id"
		},
		"domain_names": {
			"$ref": "../common.json#/properties/domain_names"
		},
		"enabled": {
			"type": "boolean"
		},
		"under_attack": {
			"type": "string",
			"enum": [
				"off",
				"on",
				"auto"
			]
		},
		"config": {
			"$ref": "./sentinel-under-attack-config.json"
		},
		"active": {
			"type": "boolean"
		},
		"since": {
			"type": [
				"string",
				"null"
			]
		},
		"until": {
			"type": [
				"string",
				"null"
			]
		},
		"reason": {
			"type": "string"
		},
		"no_autoban": {
			"type": "boolean",
			"description": "Never ban clients automatically because of this host"
		},
		"rate_limit": {
			"type": [
				"object",
				"null"
			],
			"additionalProperties": false,
			"properties": {
				"id": {
					"$ref": "../common.json#/properties/id"
				},
				"name": {
					"type": "string"
				}
			}
		}
	}
}
