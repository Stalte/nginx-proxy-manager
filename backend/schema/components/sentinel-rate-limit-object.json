{
	"type": "object",
	"description": "Sentinel rate limit policy",
	"additionalProperties": false,
	"required": [
		"id",
		"created_on",
		"modified_on",
		"owner_user_id",
		"name",
		"enabled",
		"requests_per_second",
		"burst",
		"max_connections",
		"status_code",
		"dry_run",
		"exempt",
		"host_ids"
	],
	"properties": {
		"id": {
			"$ref": "../common.json#/properties/id"
		},
		"created_on": {
			"$ref": "../common.json#/properties/created_on"
		},
		"modified_on": {
			"$ref": "../common.json#/properties/modified_on"
		},
		"owner_user_id": {
			"$ref": "../common.json#/properties/user_id"
		},
		"is_deleted": {
			"type": "boolean"
		},
		"name": {
			"type": "string",
			"minLength": 1,
			"maxLength": 64,
			"example": "Login pages"
		},
		"enabled": {
			"type": "boolean",
			"example": true
		},
		"requests_per_second": {
			"type": "integer",
			"minimum": 1,
			"maximum": 100000,
			"example": 10
		},
		"burst": {
			"type": "integer",
			"minimum": 0,
			"maximum": 100000,
			"example": 20
		},
		"max_connections": {
			"type": "integer",
			"minimum": 0,
			"maximum": 100000,
			"description": "Simultaneous connections per client (0: no limit)",
			"example": 0
		},
		"status_code": {
			"type": "integer",
			"enum": [
				429,
				503,
				403
			],
			"example": 429
		},
		"dry_run": {
			"type": "boolean",
			"description": "Only count what would be refused",
			"example": false
		},
		"exempt": {
			"type": "array",
			"maxItems": 1000,
			"items": {
				"type": "string",
				"maxLength": 64
			},
			"example": [
				"192.168.0.0/16"
			],
			"description": "Networks the policy does not limit"
		},
		"host_ids": {
			"type": "array",
			"maxItems": 10000,
			"items": {
				"type": "integer",
				"minimum": 1
			},
			"example": [
				1
			]
		},
		"stats": {
			"type": "object",
			"description": "Requests refused (or that would have been, in a dry run) over the last 10 minutes",
			"additionalProperties": false,
			"properties": {
				"limited": {
					"type": "integer",
					"example": 0
				},
				"would_limit": {
					"type": "integer",
					"example": 0
				}
			}
		}
	}
}
